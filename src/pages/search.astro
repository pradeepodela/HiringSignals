---
import Layout from '../layouts/Layout.astro';
import { niches, cities } from '../utils/leads-data';

// This would be a server-side route that handles the search
let results = [];
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const niche = formData.get('niche');
  const city = formData.get('city');
  
  // Mock results for now
  results = [
    { name: 'TechFlow Systems', signal: 'New HR Lead hired in ' + city, confidence: 0.92 },
    { name: 'Loomia AI', signal: 'Expanded office in ' + city, confidence: 0.88 },
    { name: 'NexGen Sales', signal: 'Series B funding raised recently', confidence: 0.95 }
  ];
}
---

<Layout title="Search Hiring Signals | HiringSignals.io">
	<section class="py-20">
		<div class="container mx-auto px-4">
			<h1 class="text-4xl font-bold mb-8">Search Hiring Leads</h1>
			
			<div class="bg-secondary/30 border border-white/10 rounded-2xl p-6 mb-12">
				<form method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="flex flex-col gap-2">
						<label class="text-xs font-bold uppercase text-muted">Niche</label>
						<select name="niche" class="bg-background border border-white/10 rounded-lg p-3 text-sm">
							{niches.map(n => <option value={n}>{n}</option>)}
						</select>
					</div>
					<div class="flex flex-col gap-2">
						<label class="text-xs font-bold uppercase text-muted">City</label>
						<select name="city" class="bg-background border border-white/10 rounded-lg p-3 text-sm">
							{cities.map(c => <option value={c}>{c}</option>)}
						</select>
					</div>
					<div class="flex items-end">
						<button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-bold p-3 rounded-lg transition-colors">
							Search Signals
						</button>
					</div>
				</form>
			</div>

			{results.length > 0 ? (
				<div class="space-y-4">
					<h2 class="text-2xl font-bold mb-4">Results</h2>
					{results.map(res => (
						<div class="bg-secondary/50 border border-white/10 rounded-xl p-6 flex justify-between items-center group hover:border-primary/50 transition-all">
							<div>
								<h3 class="text-xl font-bold">{res.name}</h3>
								<p class="text-muted">{res.signal}</p>
							</div>
							<div class="text-right">
								<span class="inline-block bg-primary/20 text-primary text-xs font-bold px-2 py-1 rounded-md mb-2">
									{(res.confidence * 100).toFixed(0)}% Confidence
								</span>
								<div class="flex gap-2">
									<a href="#" class="text-sm text-primary hover:underline">Get Contacts</a>
								</div>
							</div>
						</div>
					))}
				</div>
			) : (
				<div class="text-center py-24 text-muted">
					<p>Enter a niche and city to start finding leads.</p>
				</div>
			)}
		</div>
	</section>
</Layout>
